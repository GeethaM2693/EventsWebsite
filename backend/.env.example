# Server
PORT=5001
NODE_ENV=development
# Origin(s) allowed to call the API (comma-separated). Vite dev server by default.
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Atlas connection string (Atlas → Connect → Drivers). Include the database name, e.g. /events
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/events?retryWrites=true&w=majority

# Optional: pretend "today" is this date (YYYY-MM-DD). The sample listings are around 10 Oct 2026,
# so set this to demo the Today / This Weekend tabs. Leave unset to use the real date.
APP_TODAY=2026-10-10

# Protects /api/admin/* (send as X-Admin-Key). Leave empty to disable the admin routes.
ADMIN_API_KEY=
